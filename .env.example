POSTGRES_DB=eventhub
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_URL=postgresql+asyncpg://eventhub:change_this_postgres_password@postgres:5432/eventhub
ADMIN_API_KEY=replace_with_long_random_admin_key
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_BATCH_SIZE=10
HTTP_TIMEOUT_SECONDS=12
# Создаются через API POST /v1/connections. Значения ниже соответствуют secret_ref.
# TELEGRAM_BOT_TOKEN=123456:abc...
# TELEGRAM_WEBHOOK_SECRET=random_https_webhook_secret
# CALLBACK_SHARED_KEY=random_callback_key
# Для локальной тестовой отправки Telegram задайте переменные и затем зарегистрируйте connection.
